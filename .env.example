# Required: Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where lead notification emails are delivered.
LEAD_TO_EMAIL=move@wemoveondemand.com

# Copied on box order / reusable-box availability requests (api/box-availability.ts).
LEAD_CC_EMAIL=laila@wemoveondemand.com

# Verified sender on Resend (domain wemoveondemand.com must be added + verified in Resend).
LEAD_FROM_EMAIL=move@wemoveondemand.com
